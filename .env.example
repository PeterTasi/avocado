# PostgreSQL connection URL (required)
# Local:  DATABASE_URL=postgresql://postgres:password@localhost/adaptlearn
# Render: filled automatically from render.yaml
DATABASE_URL=

# Gemini AI key (required for LLM features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Max pages to OCR for scanned PDFs
MAX_OCR_PAGES=12

# CORS: comma-separated allowed origins for cross-origin requests
# Example: https://yourusername.github.io,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Optional: protect all API endpoints with a shared key
# Clients must send:  X-API-Key: <value>
API_ACCESS_KEY=

# Heatmap uplift estimation (optional tuning)
HEATMAP_UPLIFT_CAP=0.23
HEATMAP_UPLIFT_RATIO=0.35
